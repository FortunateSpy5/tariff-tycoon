{
  "name": "executive-degen",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run theme:check && npm run token:check && npm run hover:check && npm run contrast:probe && npm run size:check && vite build",
    "lint": "oxlint",
    "theme:check": "node scripts/check-theme-coverage.mjs --budget 0",
    "token:check": "node scripts/check-token-integrity.mjs --budget 30 --stock-budget 0",
    "hover:check": "node scripts/check-hover-coverage.mjs --budget 0",
    "contrast:probe": "node scripts/probe-contrast.mts",
    "size:check": "node scripts/check-file-sizes.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "break_infinity.js": "^2.2.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
